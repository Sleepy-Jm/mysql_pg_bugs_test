{
  "schema_version": 1,
  "experiment_id": "{{EXPERIMENT_ID}}",
  "run_id": "{{RUN_ID}}",
  "attempt_id": "{{STAGE1_ATTEMPT_ID}}",
  "target_id": "{{TARGET_ID}}",
  "stage": "src2req",
  "workspace_root": "{{STAGE1_ROOT}}",
  "write_root": "{{STAGE1_ROOT}}/outputs/{{STAGE1_ATTEMPT_ID}}",
  "bootstrap_control_files": [
    "{{STAGE1_ROOT}}/src2req_start.txt",
    "{{STAGE1_ROOT}}/allowlist.json"
  ],
  "network_allowed": false,
  "recursive_discovery_allowed": false,
  "read_own_current_attempt_outputs": true,
  "read_files": [
    {
      "role": "complete_example",
      "path": "{{STAGE1_ROOT}}/inputs/example_src2req.txt",
      "sha256": "{{SRC2REQ_EXAMPLE_SHA256}}"
    },
    {
      "role": "source_manifest",
      "path": "{{STAGE1_ROOT}}/inputs/source_manifest.json",
      "sha256": "{{SOURCE_MANIFEST_SHA256}}"
    },
    {
      "role": "current_source",
      "path": "{{STAGE1_ROOT}}/inputs/source_excerpt.txt",
      "sha256": "{{SOURCE_EXCERPT_SHA256}}"
    }
  ]
}
