    "parts": [
      {
        "text": "Steps in script:\npsql -c 'CREATE DATABASE test'\n# basebackup\npg_basebackup -D $backup_dir/0\nsleep 5\nrec_pit=`date +'%Y-%m-%d %H:%M:%S'`\nsleep 5\n# drop db\npsql -c 'DROP DATABASE test'\n# save backup\npsql -c 'SELECT pg_switch_wal()'\nsleep 5\n# Stop db\npg_ctl -D $PGDATAstop\n# recovery\nrm -rf $PGDATA/*\ncp -r $backup_dir/0/* $PGDATA/\ntouch $PGDATA/recovery.signal\necho \"recovery_target_time='$rec_pit'\" >> $inst_dir/postgresql.conf\n# start\npg_ctl -D $PGDATA -l ${log_dir}/pgsql.log start\nsleep 5\necho \"\\c test\" | psql;",
        "source": "experiments\\pg_report_replay_20261104\\run_001\\source_text\\17393.txt",
        "start_offset": 2175,
        "end_offset": 2690,
        "start_line": 63,
        "end_line": 88,
        "excerpt_sha256": "cfad9c33819e7a933c5d70e00ed34f89608a683dc359270e0d0178c6d9fc13dc",
        "transformations": [
          "trim outer whitespace",
          "append SQL terminator at excerpt boundary"
        ],
        "material_kind": "operational_steps"
      }
