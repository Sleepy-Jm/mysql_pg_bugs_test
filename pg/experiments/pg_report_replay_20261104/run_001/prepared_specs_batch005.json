  {
    "report_id": "17283",
    "scenario_id": "17283_main",
    "target_version": "14.1",
    "source_url": "https://www.postgresql.org/message-id/17283-ad8b80401ffe779e%40postgresql.org",
    "parts": [
      {
        "text": "Currently, PostgreSQL defaults to listen on 'localhost', which translates to\nsingle-stack IPv4 loopback address 127.0.0.1. However, IPv6 is more and more\nprevalent, not everything support happy eyeballs. Therefor, when no\nlisten_addresses are specified and/or if localhost is specified, this should\nnot default to 127.0.0.1, but instead to '127.0.0.1, ::1' to make PostreSQL\nlisten both on IPv4 and IPv6 loopback interfaces.\n\n\nThis especially fixes issues with the latest NodeJS v17.;",
        "source": "experiments\\pg_report_replay_20261104\\run_001\\source_text\\17283.txt",
        "start_offset": 235,
        "end_offset": 722,
        "start_line": 12,
        "end_line": 24,
        "excerpt_sha256": "3deb1ec0d775d4deaede4e696c3a2f712bcd8eb52952f56e12587ef7c818cf8d",
        "transformations": [
          "trim outer whitespace",
          "append SQL terminator at excerpt boundary"
        ],
        "material_kind": "operational_steps"
      }
    ],
    "mode": "listen_probe",
    "oracle": {
      "kind": "output",
      "pattern": "^IPV4_ONLY$",
      "reported_phenomenon": "默认localhost只监听IPv4而未监听IPv6",
      "author_expected_behavior": "默认同时监听127.0.0.1和::1"
    },
    "config": {
      "listen_addresses": "'localhost'"
    },
    "notes": "这是监听配置与网络探测，不是SQL；localhost解析结果随环境记录。",
    "timeout": 45,
    "preparation_status": "ready",
    "spec_sha256": "962c0107b8efd0401d880ed8abb981250fecbff26544fce62acede3d5268d9b7"
  },
