{
  "schema_version": 1,
  "stages": [
    {
      "name": "stage1_construction",
      "model": "deepseek-v4-pro",
      "prompt_file": "stage1_construction_prompt.txt",
      "output_file": "stage1_output.txt"
    },
    {
      "name": "stage2_sql",
      "model": "deepseek-v4-flash",
      "max_tokens": 16384,
      "temperature": 0.7,
      "thinking": {"type": "disabled"},
      "prompt_template_file": "stage2_sql_prompt_template.txt",
      "placeholders": ["{{STAGE1_OUTPUT}}", "{{EXECUTION_FEEDBACK}}"],
      "output_file": "stage2_output.txt"
    }
  ],
  "invocation": "Stage1 and Stage2 remain two sequential model calls. Execution feedback is produced after SQL execution and inserted into the next Stage2 request; it is not a third model stage."
}
