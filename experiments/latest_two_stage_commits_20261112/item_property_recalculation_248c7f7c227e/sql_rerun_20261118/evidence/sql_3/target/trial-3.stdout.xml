<?xml version="1.0"?>

<resultset statement="
SELECT id, x, x IN (SELECT y FROM t3_inner) AS r
FROM t3_outer
ORDER BY id" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="id">1</field>
	<field name="x">1</field>
	<field name="r">1</field>
  </row>

  <row>
	<field name="id">2</field>
	<field name="x">2</field>
	<field name="r" xsi:nil="true" />
  </row>

  <row>
	<field name="id">3</field>
	<field name="x" xsi:nil="true" />
	<field name="r" xsi:nil="true" />
  </row>

  <row>
	<field name="id">4</field>
	<field name="x">4</field>
	<field name="r" xsi:nil="true" />
  </row>
</resultset>
<?xml version="1.0"?>

<resultset statement="
-- Contrast: NOT IN over the same subquery; NULL in the subquery makes the
-- result UNKNOWN for non-matching rows, exercising the wrapper's branch.
SELECT id, x, x NOT IN (SELECT y FROM t3_inner) AS r
FROM t3_outer
ORDER BY id" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="id">1</field>
	<field name="x">1</field>
	<field name="r">0</field>
  </row>

  <row>
	<field name="id">2</field>
	<field name="x">2</field>
	<field name="r" xsi:nil="true" />
  </row>

  <row>
	<field name="id">3</field>
	<field name="x" xsi:nil="true" />
	<field name="r" xsi:nil="true" />
  </row>

  <row>
	<field name="id">4</field>
	<field name="x">4</field>
	<field name="r" xsi:nil="true" />
  </row>
</resultset>
