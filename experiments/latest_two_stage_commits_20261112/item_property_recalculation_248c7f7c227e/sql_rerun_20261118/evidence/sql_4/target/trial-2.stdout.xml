<?xml version="1.0"?>

<resultset statement="
SELECT id, g, v,
       SUM(v) OVER (PARTITION BY g ORDER BY id) + 1 AS r
FROM t4_wf
ORDER BY id" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="id">1</field>
	<field name="g">1</field>
	<field name="v">10</field>
	<field name="r">11</field>
  </row>

  <row>
	<field name="id">2</field>
	<field name="g">1</field>
	<field name="v">20</field>
	<field name="r">31</field>
  </row>

  <row>
	<field name="id">3</field>
	<field name="g">2</field>
	<field name="v">5</field>
	<field name="r">6</field>
  </row>

  <row>
	<field name="id">4</field>
	<field name="g">2</field>
	<field name="v">7</field>
	<field name="r">13</field>
  </row>
</resultset>
<?xml version="1.0"?>

<resultset statement="
-- Contrast: IS NULL over the same windowed expression, exercising the
-- Item_func_isnull container over a window-function child.
SELECT id, g, v,
       (SUM(v) OVER (PARTITION BY g ORDER BY id) + 1) IS NULL AS r
FROM t4_wf
ORDER BY id" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="id">1</field>
	<field name="g">1</field>
	<field name="v">10</field>
	<field name="r">0</field>
  </row>

  <row>
	<field name="id">2</field>
	<field name="g">1</field>
	<field name="v">20</field>
	<field name="r">0</field>
  </row>

  <row>
	<field name="id">3</field>
	<field name="g">2</field>
	<field name="v">5</field>
	<field name="r">0</field>
  </row>

  <row>
	<field name="id">4</field>
	<field name="g">2</field>
	<field name="v">7</field>
	<field name="r">0</field>
  </row>
</resultset>
