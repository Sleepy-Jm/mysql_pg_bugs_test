<?xml version="1.0"?>

<resultset statement="SELECT g, SUM(v) AS s, SUM(SUM(v)) OVER (ORDER BY g) AS running
FROM t5
GROUP BY g
ORDER BY s DESC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="g">2</field>
	<field name="s">70</field>
	<field name="running">100</field>
  </row>

  <row>
	<field name="g">3</field>
	<field name="s">50</field>
	<field name="running">150</field>
  </row>

  <row>
	<field name="g">1</field>
	<field name="s">30</field>
	<field name="running">30</field>
  </row>
</resultset>
