<?xml version="1.0"?>

<resultset statement="SELECT g, SUM(v) AS s
FROM t4
GROUP BY g
HAVING s &gt; 25
ORDER BY g" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="g">1</field>
	<field name="s">30</field>
  </row>

  <row>
	<field name="g">2</field>
	<field name="s">70</field>
  </row>

  <row>
	<field name="g">3</field>
	<field name="s">50</field>
  </row>
</resultset>
