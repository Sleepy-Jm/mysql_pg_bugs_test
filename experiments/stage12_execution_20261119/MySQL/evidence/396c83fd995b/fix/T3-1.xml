<?xml version="1.0"?>

<resultset statement="SELECT a, b, a+b AS s
FROM outer_t
WHERE (a, b) IN (SELECT p, q FROM inner_t)
ORDER BY a" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="a">1</field>
	<field name="b">10</field>
	<field name="s">11</field>
  </row>

  <row>
	<field name="a">2</field>
	<field name="b">20</field>
	<field name="s">22</field>
  </row>
</resultset>
<?xml version="1.0"?>

<resultset statement="SELECT a, b, a+b AS s
FROM outer_t o
WHERE EXISTS (SELECT 1 FROM inner_t i WHERE i.p = o.a AND i.q = o.b)
ORDER BY a" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="a">1</field>
	<field name="b">10</field>
	<field name="s">11</field>
  </row>

  <row>
	<field name="a">2</field>
	<field name="b">20</field>
	<field name="s">22</field>
  </row>
</resultset>
