<?xml version="1.0"?>

<resultset statement="SELECT a, b,
       a / b            AS str_form,
       CAST(a / b AS DECIMAL(10,2)) AS cast_form
FROM t1_src ORDER BY a" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="a">1.00</field>
	<field name="b">3.00</field>
	<field name="str_form">0.333333</field>
	<field name="cast_form">0.33</field>
  </row>

  <row>
	<field name="a">2.00</field>
	<field name="b">3.00</field>
	<field name="str_form">0.666667</field>
	<field name="cast_form">0.67</field>
  </row>

  <row>
	<field name="a">10.00</field>
	<field name="b">3.00</field>
	<field name="str_form">3.333333</field>
	<field name="cast_form">3.33</field>
  </row>
</resultset>
<?xml version="1.0"?>

<resultset statement="SELECT s, d FROM t1_dst ORDER BY s" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="s">0.333333</field>
	<field name="d">0.33</field>
  </row>

  <row>
	<field name="s">0.666667</field>
	<field name="d">0.67</field>
  </row>

  <row>
	<field name="s">3.333333</field>
	<field name="d">3.33</field>
  </row>
</resultset>
