<?xml version="1.0"?>

<resultset statement="SELECT o.id, o.v
FROM t5_outer o
WHERE o.v IN (SELECT k FROM t5_inner)
ORDER BY o.id" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="id">1</field>
	<field name="v">10</field>
  </row>

  <row>
	<field name="id">3</field>
	<field name="v">30</field>
  </row>

  <row>
	<field name="id">5</field>
	<field name="v">50</field>
  </row>
</resultset>
<?xml version="1.0"?>

<resultset statement="SELECT COUNT(*) AS matched, SUM(o.v) AS sum_v
FROM t5_outer o
WHERE o.v IN (SELECT k FROM t5_inner)" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="matched">3</field>
	<field name="sum_v">90</field>
  </row>
</resultset>
