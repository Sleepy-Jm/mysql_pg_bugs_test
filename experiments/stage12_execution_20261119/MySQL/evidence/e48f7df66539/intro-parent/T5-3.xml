<?xml version="1.0"?>

<resultset statement="SELECT b, e, COUNT(*) AS c, SUM(n) AS s
FROM t5_grp
GROUP BY b, e
ORDER BY b, e" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="b" xsi:nil="true" />
	<field name="e">x</field>
	<field name="c">1</field>
	<field name="s">60</field>
  </row>

  <row>
	<field name="b"></field>
	<field name="e">x</field>
	<field name="c">2</field>
	<field name="s">30</field>
  </row>

  <row>
	<field name="b"></field>
	<field name="e">z</field>
	<field name="c">1</field>
	<field name="s">50</field>
  </row>

  <row>
	<field name="b"></field>
	<field name="e">y</field>
	<field name="c">2</field>
	<field name="s">70</field>
  </row>
</resultset>
<?xml version="1.0"?>

<resultset statement="SELECT CAST(b AS UNSIGNED) AS b, CAST(e AS CHAR) AS e, COUNT(*) AS c, SUM(n) AS s
FROM t5_grp
GROUP BY CAST(b AS UNSIGNED), CAST(e AS CHAR)
ORDER BY b, e" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="b" xsi:nil="true" />
	<field name="e">x</field>
	<field name="c">1</field>
	<field name="s">60</field>
  </row>

  <row>
	<field name="b">1</field>
	<field name="e">x</field>
	<field name="c">2</field>
	<field name="s">30</field>
  </row>

  <row>
	<field name="b">1</field>
	<field name="e">z</field>
	<field name="c">1</field>
	<field name="s">50</field>
  </row>

  <row>
	<field name="b">2</field>
	<field name="e">y</field>
	<field name="c">2</field>
	<field name="s">70</field>
  </row>
</resultset>
