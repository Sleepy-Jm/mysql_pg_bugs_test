<?xml version="1.0"?>

<resultset statement="SELECT d.id, d.s
FROM (SELECT id, s FROM t1_derived) AS d
WHERE d.s + 0 &gt;= 3
ORDER BY d.s + 0, d.id" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="id">3</field>
	<field name="s"> 3</field>
  </row>

  <row>
	<field name="id">5</field>
	<field name="s">04</field>
  </row>

  <row>
	<field name="id">1</field>
	<field name="s">10</field>
  </row>
</resultset>
