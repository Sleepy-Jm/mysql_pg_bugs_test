<?xml version="1.0"?>

<resultset statement="SELECT u.v, COUNT(*) AS c
FROM (
  SELECT v FROM t2a
  UNION ALL
  SELECT v FROM t2b
) AS u
GROUP BY u.v
ORDER BY u.v" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="v">1.00</field>
	<field name="c">1</field>
  </row>

  <row>
	<field name="v">1.50</field>
	<field name="c">1</field>
  </row>

  <row>
	<field name="v">2.00</field>
	<field name="c">1</field>
  </row>

  <row>
	<field name="v">2.25</field>
	<field name="c">1</field>
  </row>

  <row>
	<field name="v">3.00</field>
	<field name="c">1</field>
  </row>

  <row>
	<field name="v">3.75</field>
	<field name="c">1</field>
  </row>
</resultset>
