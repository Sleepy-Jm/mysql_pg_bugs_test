<?xml version="1.0"?>

<resultset statement="SELECT
  id,
  grp,
  v,
  NTH_VALUE(v, 2) OVER (PARTITION BY grp ORDER BY id
                        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS nth2,
  LAG(v, 1) OVER (PARTITION BY grp ORDER BY id) AS lag1,
  v * 2 AS v2
FROM t4_win
ORDER BY grp, id" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <row>
	<field name="id">1</field>
	<field name="grp">1</field>
	<field name="v">10</field>
	<field name="nth2" xsi:nil="true" />
	<field name="lag1" xsi:nil="true" />
	<field name="v2">20</field>
  </row>

  <row>
	<field name="id">2</field>
	<field name="grp">1</field>
	<field name="v">20</field>
	<field name="nth2">20</field>
	<field name="lag1">10</field>
	<field name="v2">40</field>
  </row>

  <row>
	<field name="id">3</field>
	<field name="grp">1</field>
	<field name="v">30</field>
	<field name="nth2">20</field>
	<field name="lag1">20</field>
	<field name="v2">60</field>
  </row>

  <row>
	<field name="id">4</field>
	<field name="grp">2</field>
	<field name="v">40</field>
	<field name="nth2" xsi:nil="true" />
	<field name="lag1" xsi:nil="true" />
	<field name="v2">80</field>
  </row>

  <row>
	<field name="id">5</field>
	<field name="grp">2</field>
	<field name="v">50</field>
	<field name="nth2">50</field>
	<field name="lag1">40</field>
	<field name="v2">100</field>
  </row>
</resultset>
