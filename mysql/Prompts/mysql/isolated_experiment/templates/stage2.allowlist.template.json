{
  "schema_version": 1,
  "experiment_id": "{{EXPERIMENT_ID}}",
  "run_id": "{{RUN_ID}}",
  "attempt_id": "{{STAGE2_ATTEMPT_ID}}",
  "target_id": "{{TARGET_ID}}",
  "stage": "req2test",
  "workspace_root": "{{STAGE2_ROOT}}",
  "write_root": "{{STAGE2_ROOT}}/outputs/{{STAGE2_ATTEMPT_ID}}",
  "bootstrap_control_files": [
    "{{STAGE2_ROOT}}/req2test_start.txt",
    "{{STAGE2_ROOT}}/allowlist.json"
  ],
  "network_allowed": false,
  "recursive_discovery_allowed": false,
  "read_own_current_attempt_outputs": true,
  "read_files": [
    {
      "role": "complete_example",
      "path": "{{STAGE2_ROOT}}/inputs/example_req2test.txt",
      "sha256": "{{REQ2TEST_EXAMPLE_SHA256}}"
    },
    {
      "role": "requirements",
      "path": "{{STAGE2_ROOT}}/inputs/requirements.txt",
      "sha256": "{{REQUIREMENTS_SHA256}}"
    },
    {
      "role": "handoff_manifest",
      "path": "{{STAGE2_ROOT}}/inputs/handoff.json",
      "sha256": "{{HANDOFF_SHA256}}"
    }
  ]
}
