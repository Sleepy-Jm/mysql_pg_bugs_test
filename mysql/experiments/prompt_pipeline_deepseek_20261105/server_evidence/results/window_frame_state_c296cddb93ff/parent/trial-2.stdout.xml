<?xml version="1.0"?>

<resultset statement="
SELECT
  p,
  ord,
  v,
  AVG(v) OVER (
    PARTITION BY p
    ORDER BY ord
    ROWS BETWEEN 1 PRECEDING AND CURRENT ROW
  ) AS avg_v
FROM wf_avg_p
ORDER BY p, ord" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
