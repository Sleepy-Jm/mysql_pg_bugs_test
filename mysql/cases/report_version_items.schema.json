{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report x MySQL target version observations",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "task_id",
      "report_id",
      "target_version",
      "official_version_field",
      "current_category",
      "executed",
      "source_url"
    ],
    "properties": {
      "task_id": {
        "type": "string",
        "pattern": "^mysql-[0-9]+-8[.]0[.][0-9]+$"
      },
      "report_id": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "target_version": {
        "type": "string"
      },
      "current_category": {
        "enum": [
          "reproduced",
          "not_reproduced",
          "other_anomaly",
          "inconclusive",
          "not_executed",
          "execution_failed"
        ]
      },
      "executed": {
        "type": "boolean"
      },
      "independent_bug_count": {
        "type": "null"
      }
    }
  }
}
